INFINIGEN_AGENT_INFINIGEN_ROOT=/path/to/infinigen-blender-agent/third_party/infinigen
INFINIGEN_AGENT_BLENDER_BIN=/path/to/infinigen-blender-agent/third_party/infinigen/Blender.app/Contents/MacOS/Blender
INFINIGEN_AGENT_BLENDER_HOST=127.0.0.1
INFINIGEN_AGENT_BLENDER_PORT=9876
INFINIGEN_AGENT_RENDER_DIR=/path/to/infinigen-blender-agent/renders

# Optional LLM planner. Leave unset to use the offline rule planner.
# INFINIGEN_AGENT_PLANNER=llm
# INFINIGEN_AGENT_LLM_BASE_URL=https://api.openai.com/v1
# INFINIGEN_AGENT_LLM_API_KEY=sk-...
# INFINIGEN_AGENT_LLM_MODEL=gpt-4.1-mini
